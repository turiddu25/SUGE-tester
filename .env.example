# Default: Kimi Code, OpenAI-compatible, included with Kimi membership
LLM_PROVIDER=kimi_code
LLM_BASE_URL=https://api.kimi.com/coding/v1
LLM_API_KEY=sk-kimi-...
LLM_MODEL=kimi-for-coding

# Alternative: Moonshot platform, pay as you go
# LLM_PROVIDER=moonshot
# LLM_BASE_URL=https://api.moonshot.ai/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=kimi-k2-0905-preview

# Alternative: OpenAI
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Tuning
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=60
LLM_CONCURRENCY=4

DB_PATH=data/suge_tutor.db
APP_SECRET_KEY=change-me-before-hosting
APP_KEY_FREE_CALL_LIMIT=20
ALLOW_LOCAL_USER_PICKER=1

# Exam date in ISO YYYY-MM-DD. Spaced repetition compresses intervals as this approaches.
EXAM_DATE=2026-05-15
